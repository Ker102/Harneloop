        "reason": "Agent instructions and internal planning/progress; not maintained public guides."
      },
      {
        "paths": [
          "docs/releases/v0.0.1.md",
          "docs/releases/v0.0.2.md"
        ],
        "reason": "Historical English release notes; not maintained equivalents."
      },
      {
        "paths": [
          "skills/**",
          ".github/**"
        ],
        "reason": "Executable agent skills and workflow/templates, not public narrative documentation."
      },
      {
        "paths": [
          "docs/assets/**",
          "docs/diagrams/**",
          "LICENSE"
        ],
        "reason": "Shared original assets, raw code diagrams, and authoritative legal text; linked without duplication."
      },
      {
        "paths": [
          "**/runtime/**",
          "**/.playwright-cli/**",
          "**/vendor/**"
        ],
        "reason": "Generated/private/local evidence or vendor content; excluded from translation."
      }
    ]
  },
